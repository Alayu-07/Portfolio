{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.html", "options": { "printWidth": 120 } },
    { "files": "*.css", "options": { "printWidth": 120, "singleQuote": false } }
  ]
}
